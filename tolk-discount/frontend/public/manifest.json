    },
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/app/tolk-discount/id1234567890"
    }
  ],
  "prefer_related_applications": false,
  "protocol_handlers": [
    {
      "protocol": "web+tolk",
      "url": "/open?url=%s"
    }
  ],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
